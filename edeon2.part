(function(){
var st=document.createElement('style');st.id='edeonCss2';
st.textContent=
"#board[data-th=edeon] .pc{width:var(--pz,80%)!important;height:var(--pz,80%)!important;border-radius:50%!important;background-size:auto!important}"+
"#board[data-th=edeon] .pc.w{background:radial-gradient(circle at 35% 28%,#fff 0,#f2f2f2 35%,#b9b9b9 100%)!important;border:2px solid #9a9a9a!important;box-shadow:0 3px 4px #0007,inset 0 -3px 4px #0003,inset 0 2px 3px #fff!important}"+
"#board[data-th=edeon] .pc.b{background:radial-gradient(circle at 35% 28%,#8a8a8a 0,#3a3a3a 35%,#0b0b0b 100%)!important;border:2px solid #000!important;box-shadow:0 3px 4px #000a,inset 0 -3px 4px #0008,inset 0 2px 3px #777!important}"+
"#board[data-th=edeon] .pc::before{content:'';position:absolute;inset:14%;border-radius:50%;border:3px solid #0004;box-shadow:inset 0 0 0 3px #fff3,0 0 0 3px #0002}"+
"#board[data-th=edeon] .pc.w::before{border-color:#8885;box-shadow:inset 0 0 0 3px #fff9,0 0 0 3px #0001}"+
"#board[data-th=edeon] .pc.k::before{inset:10%;border:3px solid #e0a800;box-shadow:inset 0 0 0 3px #ffe58a88,0 0 7px #ffc400,0 0 0 2px #7a5600aa}"+
"#board[data-th=edeon] .pc.k::after{content:'\\u265B';color:#ffcf33;font-size:clamp(14px,5vw,32px);text-shadow:0 1px 1px #000,0 0 6px #ff9d00}"+
"#board[data-th=edeon] .pc.k.w::after{color:#d99a00;text-shadow:0 1px 1px #fff8,0 0 5px #ffb300}";
document.head.appendChild(st);
})();
