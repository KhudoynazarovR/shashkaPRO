(function(){
var st=document.createElement('style');st.id='edeonCss';
st.textContent=
"#board[data-th=edeon]{border:14px solid #e9a868;border-radius:3px;box-sizing:border-box;box-shadow:0 0 0 2px #8a4a1c,inset 0 0 0 2px #8a4a1c,0 8px 22px #0006}"+
